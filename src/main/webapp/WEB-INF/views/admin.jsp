<%@ page import="java.util.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%String ctx=request.getContextPath();List<Map<String,Object>> claims=(List<Map<String,Object>>)request.getAttribute("claims");List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("items");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin · FindIt</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=ctx%>/home">Find<span>It.</span></a><nav class="nav"><a href="<%=ctx%>/home">Dashboard</a><a href="<%=ctx%>/items">Browse</a><a href="<%=ctx%>/logout">Log out</a></nav></header><main class="container"><div class="eyebrow">Control centre</div><h1>Administrator dashboard</h1><p class="muted">Review claims and monitor campus reports.</p><div class="stats"><div class="card stat"><span class="muted">Registered users</span><strong><%=request.getAttribute("usersCount")%></strong></div><div class="card stat"><span class="muted">Item reports</span><strong><%=request.getAttribute("itemsCount")%></strong></div><div class="card stat"><span class="muted">Claims</span><strong><%=request.getAttribute("claimsCount")%></strong></div></div><div class="section-title"><h2>Claim review</h2></div><%if(claims==null||claims.isEmpty()){%><div class="card">There are no claims to review.</div><%}else{%><div class="table-wrap"><table><thead><tr><th>Item</th><th>Claimant</th><th>Verification answer</th><th>Status</th><th>Review</th></tr></thead><tbody><%for(Map<String,Object> c:claims){%><tr><td><b><%=esc(c.get("item_name"))%></b><div class="meta"><%=c.get("report_type")%> · #<%=c.get("item_id")%></div></td><td><%=esc(c.get("claimant_name"))%></td><td><%=esc(c.get("verification_answer"))%></td><td><span class="pill"><%=c.get("status")%></span></td><td><%if("PENDING".equals(c.get("status"))){%><form method="post" action="<%=ctx%>/claim-action" style="display:flex;gap:6px;flex-wrap:wrap"><input type="hidden" name="claimId" value="<%=c.get("claim_id")%>"><button class="btn small" name="status" value="APPROVED">Approve</button><button class="btn small danger" name="status" value="REJECTED">Reject</button></form><%}%></td></tr><%}%></tbody></table></div><%}%><div class="section-title"><h2>Recent reports</h2></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Owner</th><th>Type</th><th>Location</th><th>Status</th></tr></thead><tbody><%if(items!=null)for(Map<String,Object> i:items){%><tr><td><%=esc(i.get("item_name"))%></td><td><%=esc(i.get("full_name"))%></td><td><%=i.get("report_type")%></td><td><%=esc(i.get("location"))%></td><td><%=i.get("status")%></td></tr><%}%></tbody></table></div></main></body></html><%!private String esc(Object o){if(o==null)return "—";return String.valueOf(o).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>
