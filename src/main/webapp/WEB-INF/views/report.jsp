<%@ page import="java.util.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%String ctx=request.getContextPath();List<Map<String,Object>> cats=(List<Map<String,Object>>)request.getAttribute("categories");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Report item · FindIt</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=ctx%>/home">Find<span>It.</span></a><nav class="nav"><a href="<%=ctx%>/items">Browse</a><a href="<%=ctx%>/my-items">My reports</a></nav></header><main class="container"><section class="card form-card"><div class="eyebrow">Help the community</div><h1>Report an item</h1><p class="muted">Include useful details, but keep one identifying detail for verification.</p><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><form method="post" action="<%=ctx%>/report"><div class="form-group"><label>Report type *</label><select name="reportType" required><option value="LOST">I lost an item</option><option value="FOUND">I found an item</option></select></div><div class="form-group"><label>Item name *</label><input name="itemName" maxlength="150" required placeholder="e.g. Blue water bottle"></div><div class="form-group"><label>Category *</label><select name="categoryId" required><%if(cats!=null)for(Map<String,Object> c:cats){%><option value="<%=c.get("id")%>"><%=c.get("name")%></option><%}%></select></div><div class="form-row"><div class="form-group"><label>Colour</label><input name="color" maxlength="60" placeholder="e.g. navy blue"></div><div class="form-group"><label>Date *</label><input type="date" name="itemDate" required></div></div><div class="form-group"><label>Location *</label><input name="location" maxlength="200" required placeholder="e.g. Library, second floor"></div><div class="form-group"><label>Description</label><textarea name="description" maxlength="3000" placeholder="Brand, appearance, approximate time, etc."></textarea></div><button class="btn" type="submit">Publish report</button> <a class="btn secondary" href="<%=ctx%>/items">Cancel</a></form></section></main></body></html>
