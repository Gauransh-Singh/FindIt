<%@ page import="java.util.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><% String ctx=request.getContextPath(); List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("items"); String search=(String)request.getAttribute("search"); String type=(String)request.getAttribute("type"); %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Browse items · FindIt</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=ctx%>/home">Find<span>It.</span></a><nav class="nav"><a href="<%=ctx%>/home">Dashboard</a><a href="<%=ctx%>/my-items">My reports</a><a href="<%=ctx%>/report">＋ Report item</a><% if("ADMIN".equals(session.getAttribute("role"))){ %><a href="<%=ctx%>/admin">Admin</a><% } %><form action="<%=ctx%>/logout" method="post" style="margin:0"><button class="btn secondary" type="submit">Log out</button></form></nav></header><main class="container"><div class="section-title"><div><div class="eyebrow">Campus board</div><h1>Browse reports</h1><p class="muted">Search lost and found reports. Open a claim only when you can describe a verifying detail.</p></div><a class="btn" href="<%=ctx%>/report">＋ Report item</a></div><%if("1".equals(request.getParameter("posted"))){%><div class="alert success">Your report has been posted.</div><%}%><%if("1".equals(request.getParameter("claimed"))){%><div class="alert success">Your claim was submitted for review.</div><%}%><%if("claim".equals(request.getParameter("error"))){%><div class="alert">Claim could not be submitted. Check your answer, and make sure you are not claiming your own item.</div><%}%><form class="search" method="get"><input name="q" value="<%=search==null?"":search.replace("&","&amp;").replace("\"","&quot;")%>" placeholder="Search name, description, location…"><select name="type"><option value="">All reports</option><option value="LOST" <%="LOST".equals(type)?"selected":""%>>Lost items</option><option value="FOUND" <%="FOUND".equals(type)?"selected":""%>>Found items</option></select><button class="btn" type="submit">Search</button><a class="btn secondary" href="<%=ctx%>/items">Clear</a></form><%if(items==null||items.isEmpty()){%><div class="card"><h3>No reports found yet</h3><p class="muted">Try another search or create the first report.</p></div><%}else{%><div class="grid"><%for(Map<String,Object> i:items){String rt=String.valueOf(i.get("report_type"));int id=((Number)i.get("item_id")).intValue();%><article class="card item-card"><span class="pill <%=rt.toLowerCase()%>"><%=rt%></span><h3><%=esc(i.get("item_name"))%></h3><div class="meta"><%=esc(i.get("category_name"))%> · <%=esc(i.get("item_date"))%></div><p><%=esc(i.get("description"))%></p><div class="meta">📍 <%=esc(i.get("location"))%></div><div class="meta">Colour: <%=esc(i.get("color"))%> · Posted by <%=esc(i.get("full_name"))%></div><span class="pill"><%=esc(i.get("status"))%></span><%if(!"RESOLVED".equals(i.get("status"))&&((Number)i.get("user_id")).intValue()!=((Number)session.getAttribute("userId")).intValue()){%><details style="margin-top:14px"><summary style="cursor:pointer;color:#315fe8;font-weight:750">Claim this item</summary><form method="post" action="<%=ctx%>/claim"><input type="hidden" name="itemId" value="<%=id%>"><div class="form-group"><label>Verification details</label><textarea name="answer" minlength="5" required placeholder="Describe a detail that verifies the item is yours or that you can identify…"></textarea></div><button class="btn small" type="submit">Submit claim</button></form></details><%}%><a style="display:inline-block;margin-top:12px" href="<%=ctx%>/matches?id=<%=id%>">View possible matches →</a></article><%}%></div><%}%></main><footer>FindIt · Please verify ownership before handing over belongings.</footer></body></html><%! private String esc(Object o){if(o==null)return "—";return String.valueOf(o).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>
