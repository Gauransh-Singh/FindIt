<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html lang="en"><head><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Log in — FindIt</title><style>
*{box-sizing:border-box}body{margin:0;background:#f5f8ff;color:#142b4a;font-family:Segoe UI,Arial,sans-serif;min-height:100vh;display:grid;place-items:center;padding:24px}.card{width:100%;max-width:440px;background:#fff;border:1px solid #e7ecf5;border-radius:24px;padding:36px;box-shadow:0 18px 55px #142b4a0b}.brand{font-size:26px;font-weight:850;text-decoration:none;color:#142b4a}.brand span{color:#3267e9}h1{margin:25px 0 8px;font-size:30px}p{color:#64748b;line-height:1.5}.field{display:block;font-weight:650;margin-top:18px}.field input{display:block;width:100%;margin-top:8px;padding:13px 14px;border:1px solid #d8e0ee;border-radius:10px;font:inherit}.btn{width:100%;border:0;background:#3267e9;color:white;padding:14px;border-radius:11px;font-weight:750;font-size:15px;margin-top:23px;cursor:pointer}.error{background:#fff0f0;color:#a32626;padding:12px;border-radius:10px}.success{background:#eaf8ef;color:#176534;padding:12px;border-radius:10px}.bottom{text-align:center;margin-top:20px}.bottom a{color:#3267e9;font-weight:700;text-decoration:none}</style></head><body><main class="card"><a class="brand" href="${pageContext.request.contextPath}/">Find<span>It.</span></a><h1>Welcome back</h1><p>Log in to manage your lost and found reports.</p><% if ("1".equals(request.getParameter("registered"))) { %><div class="success">Account created successfully. You can now log in.</div><% } %><% if ("1".equals(request.getParameter("loggedOut"))) { %><div class="success">You have been logged out.</div><% } %><% if (request.getAttribute("error") != null) { %><div class="error"><%= request.getAttribute("error") %></div><% } %><form method="post" action="${pageContext.request.contextPath}/login"><label class="field">Email address<input name="email" type="email" maxlength="150" required autocomplete="email" value="<%= request.getParameter("email") == null ? "" : request.getParameter("email").replace("&","&amp;").replace("\"","&quot;").replace("<","&lt;").replace(">","&gt;") %>"></label><label class="field">Password<input name="password" type="password" required autocomplete="current-password"></label><button class="btn" type="submit">Log in</button></form><div class="bottom">New to FindIt? <a href="${pageContext.request.contextPath}/register">Create an account</a></div></main></body></html>
