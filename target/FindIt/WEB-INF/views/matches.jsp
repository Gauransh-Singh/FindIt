<%@ page import="java.util.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%String ctx=request.getContextPath();Map<String,Object> src=(Map<String,Object>)request.getAttribute("sourceItem");List<Map<String,Object>> matches=(List<Map<String,Object>>)request.getAttribute("matches");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Possible matches · FindIt</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=ctx%>/home">Find<span>It.</span></a><nav class="nav"><a href="<%=ctx%>/items">Browse items</a><a href="<%=ctx%>/report">Report item</a><a href="<%=ctx%>/my-items">My reports</a></nav></header><main class="container"><a href="<%=ctx%>/items">← Back to reports</a><%if(src==null){%><div class="card"><h2>Report not found</h2></div><%}else{%><div class="section-title"><div><div class="eyebrow">Smart matching</div><h1>Possible matches</h1><p class="muted">Matching is based on the opposite report type and same category, then prioritizes nearby dates. Please verify details directly.</p></div></div><div class="card"><span class="pill"><%=src.get("report_type")%> report</span><h3><%=esc(src.get("item_name"))%></h3><p><%=esc(src.get("category_name"))%> · <%=esc(src.get("location"))%> · <%=esc(src.get("item_date"))%></p></div><div class="section-title"><h2>Suggested reports</h2></div><%if(matches==null||matches.isEmpty()){%><div class="card">No opposite-type reports in this category yet. Check back later.</div><%}else{%><div class="grid"><%for(Map<String,Object> m:matches){%><div class="card"><span class="pill <%=String.valueOf(m.get("report_type")).toLowerCase()%>"><%=m.get("report_type")%></span><h3><%=esc(m.get("item_name"))%></h3><div class="meta"><%=esc(m.get("category_name"))%> · <%=esc(m.get("item_date"))%></div><p><%=esc(m.get("description"))%></p><div class="meta">📍 <%=esc(m.get("location"))%> · Colour: <%=esc(m.get("color"))%></div><a class="btn small" href="<%=ctx%>/items">View report / claim</a></div><%}%></div><%}%><%}%></main></body></html><%!private String esc(Object o){if(o==null)return "—";return String.valueOf(o).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>
