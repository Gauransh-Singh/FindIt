<%@ page import="java.util.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%String ctx=request.getContextPath();List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("items");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My reports · FindIt</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body><header class="topbar"><a class="brand" href="<%=ctx%>/home">Find<span>It.</span></a><nav class="nav"><a href="<%=ctx%>/items">Browse reports</a><a href="<%=ctx%>/report">Report item</a><a href="<%=ctx%>/home">Dashboard</a></nav></header><main class="container"><div class="section-title"><div><div class="eyebrow">Your activity</div><h1>My reports</h1></div><a class="btn" href="<%=ctx%>/report">＋ New report</a></div><%if(items==null||items.isEmpty()){%><div class="card"><h3>You haven't posted a report yet.</h3><a class="btn" href="<%=ctx%>/report">Create your first report</a></div><%}else{%><div class="table-wrap"><table><thead><tr><th>Item</th><th>Type</th><th>Location</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody><%for(Map<String,Object> i:items){%><tr><td><b><%=esc(i.get("item_name"))%></b><div class="meta"><%=esc(i.get("category_name"))%></div></td><td><%=i.get("report_type")%></td><td><%=esc(i.get("location"))%></td><td><%=i.get("item_date")%></td><td><span class="pill"><%=i.get("status")%></span></td><td><%if(!"RESOLVED".equals(i.get("status"))){%><form method="post" action="<%=ctx%>/resolve"><input type="hidden" name="itemId" value="<%=i.get("item_id")%>"><button class="btn small secondary" type="submit">Mark resolved</button></form><%}%><a href="<%=ctx%>/matches?id=<%=i.get("item_id")%>">Matches</a></td></tr><%}%></tbody></table></div><%}%></main></body></html><%!private String esc(Object o){if(o==null)return "—";return String.valueOf(o).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}%>
